void I2C_PeriClockControl(I2C_RegDef_t *pI2Cx, uint8_t EnorDi)
{
	if(EnorDi == ENABLE)
	{
		if(pI2Cx == I2C1) { I2C1_CLK(); }
		else if (pI2Cx == I2C2) { I2C2_CLK(); }
		else if (pI2Cx == I2C3) { I2C3_CLK(); }
	}
	else
	{
		//TODO
	}
}


void I2C_Init(I2C_Handle_t *pI2CHandle)
{
	uint32_t tempreg = 0;
	// 1. 클럭 황성화
	I2C_PeriClockControl(pI2CHandle->pI2Cx, ENABLE);
	// 2. ACK 비트를 CR1에 미리 심어두기
	tempreg |= pI2CHandle->I2C_Config.I2C_AckControl << 10;
	pI2CHandle->pI2Cx->CR1 = tempreg;  // CR1 내 ACK설정값을 0으로 설정/PE잔여값을 0으로 밀어버리는 효과
	// 3. CR2 - FERQ 필드 설정
	tempreg = 0;
	tempreg |= RCC_GetPCLK1Value() / 100000U;
	pI2CHandle->pI2Cx->CR2 = ((tempreg & 0x3F) << I2C_CR2_FREQ);
	// 4. OAR1 - 자기 주소 설정
	tempreg = 0;
	tempreg |= pI2CHandle->I2C_Config.I2C_DeviceAddress << 1;
	tempreg |= (1 << 14);
	pI2CHandle->pI2Cx->OAR1 = tempreg;
	// 5. CCR 계산
	uint16_t ccr_value = 0;
	tempreg = 0;
	if(pI2CHandle->I2C_Config.I2C_SCLSpeed <= I2C_SCL_SPEED_SM)
	{
		ccr_vlaue = (RCC_GetPCLK1Value() / (2 * pI2CHandle->I2C_Config.I2C_SCLSpeed));
		tempreg |= (ccr_value & 0xFFF);
	}
	else
	{
		tempreg |= (1 << 15);
		tempreg |= (pI2CHandle->I2C_Config.I2C_FMDutyCycle << 14);
		if(pI2CHandle->I2C_Config.I2C_FMDutyCycle == I2C_FM_DUTY_2)
		{
			ccr_value = (RCC_GerPCLK1Value() / (3 * pI2CHandle->I2C_Config.I2C_SCLSpeed));
		}
		else
		{
			ccr_value = (RCC_GerPCLK1Value() / (25 * pI2CHandle->I2C_Config.I2C_SCLSpeed));
		}
		tempreg |= (ccr_value & 0xFFF);
	}
	pI2CHandle->pI2Cx->CCR = tempreg;

	if(pI2CHandle->I2C_Config.I2C_SCLSpeed <= I2C_SCL_SPEED_SM)
	{
		tempreg = (RCC_GetPCLK1Value() / 1000000U) + 1;
	}
	else
	{
		tempreg = ((RCC_GetPCLK1Value() * 300) / 1000000000U) + 1;
	}
	pI2CHandle->pI2Cx->TRISE = (tempreg & 0x3F);
}

