uint32_t RCC_GetPCLK1Value(void)
{
	uint32_t pclk1, SystemClk;

	uint8_t clksrc, temp, ahbp, apb1p;

	clksrc = ((RCC->CFGR >> 2) & 0x3);

	if(clksrc == 0 )
	{
		SystemClk = 16000000;
	}else if( clksrc == 1 )
	{
		SystemClk = 8000000;
	}else if( clksrc == 2 )
	{
		SystemClk = RCC_GetPLLOutputClock();
	}
}

